# Copy to backend/.env for local (non-Docker) development.
DATABASE_URL=postgresql+asyncpg://walkitecture:walkitecture@localhost:5433/walkitecture
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=25

# OpenAI edit interpretation (optional: without a key the rule-based interpreter is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# DWG -> DXF converter (LibreDWG). Preinstalled in the Docker image.
DWG2DXF_PATH=dwg2dxf

# Drawing convention: comma-separated, case-insensitive layer-name globs
WALL_LAYERS=WALL,WALLS,A-WALL*
WINDOW_LAYERS=WINDOW,WINDOWS,A-GLAZ*,A-WIND*
DOOR_LAYERS=DOOR,DOORS,A-DOOR*
ROOM_LAYERS=ROOM,ROOMS,A-AREA*,A-ROOM*

# Geometry defaults (meters)
DEFAULT_WALL_THICKNESS=0.15
DEFAULT_CEILING_HEIGHT=2.7
