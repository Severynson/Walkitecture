# Copy to backend/.env for local (non-Docker) development.
DATABASE_URL=postgresql+asyncpg://walkitecture:walkitecture@localhost:5433/walkitecture
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=25

# Auth: sign JWTs with a stable secret (openssl rand -hex 32). Unset = random per process.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# OpenAI (optional): edit interpretation + identifying unknown furniture blocks. Without a key,
# the rule-based interpreter and rule/size-based furniture matching are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# DWG -> DXF converter (LibreDWG). Preinstalled in the Docker image.
DWG2DXF_PATH=dwg2dxf

# Drawing convention: comma-separated, case-insensitive layer-name globs
WALL_LAYERS=WALL,WALLS,A-WALL*,MURO*,MUROS*
WINDOW_LAYERS=WINDOW,WINDOWS,A-GLAZ*,A-WIND*,VENTANA*
DOOR_LAYERS=DOOR,DOORS,A-DOOR*,PUERTA*
OPENING_LAYERS=CARPINTERIA*,CARPENTRY*,A-OPEN*,CERR*
ROOM_LAYERS=ROOM,ROOMS,A-AREA*,A-ROOM*,SUPERFICIE*
FURNITURE_LAYERS=FURN*,A-FURN*,I-FURN*,A-FLOR-FIXT*,PLUMB*,MUEBLE*,MOB*,SANITARIO*

# Geometry defaults (meters). ARCHITECTURE.md: walls 10 ft, doors 0-7 ft, windows 2.5-6.5 ft.
DEFAULT_WALL_THICKNESS=0.15
DEFAULT_CEILING_HEIGHT=3.048
DEFAULT_DOOR_HEIGHT=2.1336
DEFAULT_WINDOW_SILL_HEIGHT=0.762
DEFAULT_WINDOW_HEIGHT=1.2192
