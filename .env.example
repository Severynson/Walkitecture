# Copy to .env (git-ignored) next to docker-compose.yml. Dev works without any of these.

# --- Database ---------------------------------------------------------------------------
POSTGRES_USER=walkitecture
POSTGRES_PASSWORD=            # required in production (use `openssl rand -hex 24`)
POSTGRES_DB=walkitecture

# --- Auth -------------------------------------------------------------------------------
JWT_SECRET=                   # required in production (`openssl rand -hex 32`)
# JWT_EXPIRE_MINUTES=10080

# --- Seeded account (dev defaults demo / walkitecture-demo; prod: off unless both set) ----
# SEED_USERNAME=demo
# SEED_PASSWORD=
# SEED_SAMPLE_PLANS=true

# --- LLM (optional; rule-based fallbacks without a key) ---------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=high     # minimal|low|medium|high; empty = model default. high: ~70 s per plan classify, low: ~22 s
# OPENAI_TIMEOUT_S=300

# --- Limits -----------------------------------------------------------------------------
# MAX_UPLOAD_MB=25
# PROCESS_IN_BACKGROUND=true    # uploads return at once; a background job runs AI classification + checks
# PARSE_WORKERS=2               # worker processes for reading drawings and running the checks
# PARSE_TIMEOUT_S=300           # a step taking longer fails the plan as "too complex" (the server stays up)
# LOGIN_RATE_LIMIT=10            # login/token attempts per minute per client IP (0 disables)
# REGISTER_RATE_LIMIT=5          # registrations per minute per client IP
# APP_ENV=development            # production refuses a weak JWT_SECRET / default seed password (prod compose sets it)

# --- Production / Traefik (docker-compose.prod.yml) ---------------------------------------
APP_DOMAIN=                   # e.g. walkitecture.severyn.xyz
# TRAEFIK_NETWORK=web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
