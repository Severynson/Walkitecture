# Copy to .env (git-ignored) next to docker-compose.yml. Dev works without any of these.

# --- Database ---------------------------------------------------------------------------
POSTGRES_USER=walkitecture
POSTGRES_PASSWORD=            # required in production (use `openssl rand -hex 24`)
POSTGRES_DB=walkitecture

# --- Auth -------------------------------------------------------------------------------
JWT_SECRET=                   # required in production (`openssl rand -hex 32`)
# JWT_EXPIRE_MINUTES=10080

# --- Seeded account (dev defaults demo / walkitecture-demo; prod: off unless both set) ----
# SEED_USERNAME=demo
# SEED_PASSWORD=
# SEED_SAMPLE_PLANS=true

# --- LLM (optional; rule-based fallbacks without a key) ---------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# --- Limits -----------------------------------------------------------------------------
# MAX_UPLOAD_MB=25

# --- Production / Traefik (docker-compose.prod.yml) ---------------------------------------
APP_DOMAIN=                   # e.g. walkitecture.severyn.xyz
# TRAEFIK_NETWORK=web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
